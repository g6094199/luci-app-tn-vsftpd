config vsftpd 'listen'
	option enabled '1'
	option enable4 '1'
	option ipv4 '0.0.0.0'
	option port '21'
	option dataport '20'

config vsftpd 'global'
	option write '1'
	option download '1'
	option dirlist '1'
	option umask '022'
	option dotfile '1'
	option dirmessage '1'

config vsftpd 'local'
	option enabled '1'
	option root ''

config vsftpd 'connection'
	option portmode '1'
	option pasvmode '1'
	option pasvminport '10050'
	option pasvmaxport '10100'
	option idletimeout '1800'
	option conntimeout '120'
	option maxclient '0'
	option maxperip '0'
