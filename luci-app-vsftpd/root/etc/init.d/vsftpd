#!/bin/sh /etc/rc.common

# Copyright 2026 Wi-Tech
# Licensed under Apache-2.0

START=95
USE_PROCD=1

# Hier wird die UCI-Konfiguration in das VSFTP-Format umgewandelt
generate_vsftpd_conf() {
	local conf_file="/var/etc/vsftpd.conf"
	mkdir -p /var/etc

	# Standard-Header
	echo "# Auto-generated by Wi-Tech vsftpd-wt" > "$conf_file"
	echo "background=NO" >> "$conf_file"
	echo "dirmessage_enable=YES" >> "$conf_file"

	# Werte aus UCI 'listen' Sektion
	config_get_bool enabled listen enabled 0
	[ "$enabled" -eq 0 ] && return 1

	config_get port listen port 21
	echo "listen_port=$port" >> "$conf_file"

	# Werte aus UCI 'global' Sektion
	config_get_bool write global write 0
	if [ "$write" -eq 1 ]; then
		echo "write_enable=YES" >> "$conf_file"
	else
		echo "write_enable=NO" >> "$conf_file"
	fi

	# Werte aus UCI 'local' Sektion
	config_get_bool local_enabled local enabled 0
	if [ "$local_enabled" -eq 1 ]; then
		echo "local_enable=YES" >> "$conf_file"
	else
		echo "local_enable=NO" >> "$conf_file"
	fi

	return 0
}

start_service() {
	config_load 'vsftpd'
	
	generate_vsftpd_conf || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/vsftpd /var/etc/vsftpd.conf
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "vsftpd"
}
